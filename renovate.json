{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex"],
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/(_build|e2e)\\.yml$/"],
      "matchStrings": [
        "SBX_VERSION: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\s+SBX_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "docker/sbx-releases",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(_build|scan)\\.yml$/"
      ],
      "matchStrings": [
        "TRIVY_VERSION: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["docker/sbx-releases"],
      "groupName": "sbx runtime and signing CLI",
      "schedule": ["before 6am on monday"]
    },
    {
      "matchPackageNames": ["aquasecurity/trivy"],
      "groupName": "Trivy scanner",
      "schedule": ["before 6am on monday"]
    }
  ]
}
